ADMIN_EMAIL=your_admin_email
ADMIN_PASSWORD=your_admin_password

JWT_SECRET=replace_with_a_long_random_secret

MONGO_URI=mongodb+srv://your_mongodb_atlas_connection_string

# Local: http://localhost:5173
# Production: https://your-vercel-project.vercel.app
# Multiple exact origins are comma-separated.
CORS_ACCESS=https://your-vercel-project.vercel.app

# The public Render URL, used when saving uploaded file links.
SERVER_URL=https://your-render-service.onrender.com

# Select where all product, vendor, category, collection, and banner media is stored.
# Use "local" only with persistent server storage; use "cloudinary" on Render.
STORAGE_PROVIDER=cloudinary
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
